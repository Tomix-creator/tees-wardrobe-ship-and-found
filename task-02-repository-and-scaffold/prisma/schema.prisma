generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Order {
  id               Int      @id @default(autoincrement())
  customerName     String
  garment          String
  priceNaira       Int
  deliveryFeeNaira Int?
  createdAt        DateTime @default(now())
}

